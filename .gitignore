# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Python cache / build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# LaTeX build files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# Temporary files
tmp/
temp/
*.tmp

# Archives / compressed files
*.zip
*.tar
*.tar.gz
*.rar

# Keep the recorded experiment logs in extensions/ (they are part of the
# evidence trail; the *.log rules above would otherwise drop them)
!extensions/**/*.log
